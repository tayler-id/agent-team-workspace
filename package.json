{
	"name": "agora",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.1",
	"engines": {
		"node": ">=24.16.0 <25",
		"pnpm": ">=10.34.1 <11"
	},
	"scripts": {
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json && tsc -p packages/client-core/tsconfig.json && tsc -p apps/web/tsconfig.json",
		"boundaries": "vitest run --project unit packages/client-core/test/boundaries.test.ts packages/client-core/test/export-maps.test.ts packages/client-core/test/app-architecture.test.ts packages/client-core/test/pretext-boundary.test.ts --reporter=json --outputFile=.scratch/boundaries.json",
		"docs:check": "markdownlint-cli2 AGENTS.md 'docs/**/*.md' 'evidence/**/*.md' '.agents/skills/verify-agora/SKILL.md' && node scripts/verify-design.mjs && node scripts/verify-design-handoff.mjs && pnpm docs:validate && pnpm docs:test",
		"docs:dev": "node docs/site/serve.mjs",
		"docs:build": "node docs/site/build.mjs",
		"docs:validate": "node docs/site/build.mjs --check",
		"docs:atlas": "node docs/site/build.mjs --mirror --check",
		"docs:test": "node --test docs/site/test/*.test.ts",
		"contracts:generate": "node contracts/tools/generate.mjs",
		"contracts:check": "node contracts/tools/generate.mjs --check",
		"contracts:conform": "node contracts/src/conform-cli.ts",
		"client:replay": "node scripts/drive-client-core.ts",
		"verify:foundation": "node scripts/foundation.mjs",
		"test": "node scripts/with-test-postgres.mjs vitest run",
		"test:unit": "vitest run --project unit --project contracts",
		"test:pg": "node scripts/with-test-postgres.mjs vitest run --project pg",
		"migrate": "node packages/storage/src/migrate-cli.ts",
		"migrate:ephemeral": "node scripts/with-test-postgres.mjs node packages/storage/src/migrate-cli.ts",
		"web:dev": "pnpm --filter @agora/web dev",
		"web:build": "pnpm --filter @agora/web build",
		"web:test": "pnpm --filter @agora/web exec vitest run --config vitest.config.ts",
		"check": "pnpm lint && pnpm typecheck && pnpm docs:check && pnpm contracts:check && pnpm test"
	},
	"devDependencies": {
		"@agora/client-core": "workspace:*",
		"@agora/contracts": "workspace:*",
		"@eslint/js": "10.0.1",
		"@types/node": "24.10.1",
		"@typescript-eslint/utils": "8.70.0",
		"eslint": "10.11.0",
		"markdown-it": "14.3.0",
		"markdownlint-cli2": "0.23.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.70.0",
		"vitest": "5.0.1"
	}
}

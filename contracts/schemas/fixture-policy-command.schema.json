{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://agora.invalid/schemas/fixture-policy-command.schema.json",
	"title": "agora.fixture-policy-command/v1",
	"description": "Non-production foundation fixture. Asks the pure policy fixture whether an actor scope may touch a subject scope.",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema_version", "actor", "subject"],
	"properties": {
		"schema_version": { "const": "agora.fixture-policy-command/v1" },
		"actor": { "$ref": "#/$defs/scoped" },
		"subject": { "$ref": "#/$defs/scoped" }
	},
	"$defs": {
		"scoped": {
			"type": "object",
			"additionalProperties": false,
			"required": ["scope_id"],
			"properties": {
				"scope_id": { "type": "string", "format": "uuid" }
			}
		}
	}
}

{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://agora.invalid/schemas/cli.schema.json",
	"title": "agora.cli/v1",
	"description": "R12 verification CLI envelopes: the registered command, its JSON report, closed outcomes and exit semantics. Every project capability is driven and proven through these shapes; a browser or native UI invokes the same authority and is never the only path.",
	"$defs": {
		"CliOutcome": {
			"description": "Closed outcome set. Process exit follows the outcome exactly: pass 0, fail 1, blocked 2, unavailable 3, usage_error 64, infrastructure_failure 70. A report whose exit disagrees with its outcome is invalid evidence.",
			"type": "string",
			"enum": ["pass", "fail", "blocked", "unavailable", "usage_error", "infrastructure_failure"]
		},
		"ExitCode": {
			"description": "The only process exit codes a verification command may return; see CliOutcome for their meaning.",
			"type": "integer",
			"enum": [0, 1, 2, 3, 64, 70]
		},
		"CliCommandName": {
			"type": "string",
			"enum": ["doctor", "scenarios", "start", "verify", "evidence", "stop", "lanes"]
		},
		"CliCommand": {
			"description": "Structured form of one registered project command (R12). The runner builds argv from this object; it never evaluates command text received from chat.",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema_version", "command"],
			"properties": {
				"schema_version": { "type": "string", "enum": ["agora.cli-command/v1"] },
				"command": { "$ref": "#/$defs/CliCommandName" },
				"profile": { "type": "string", "enum": ["verify"] },
				"instance": { "$ref": "primitives.schema.json#/$defs/Uuid" },
				"scenario": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
				"unit": { "type": "string", "pattern": "^U[0-9]{2}[a-d]?$" },
				"artifacts": { "type": "string", "minLength": 1, "maxLength": 4096 }
			}
		},
		"Diagnostic": {
			"type": "object",
			"additionalProperties": false,
			"required": ["reason_code", "message"],
			"properties": {
				"reason_code": { "$ref": "errors.schema.json#/$defs/ReasonCode" },
				"message": { "type": "string", "maxLength": 4096 }
			}
		},
		"ArtifactReference": {
			"type": "object",
			"additionalProperties": false,
			"required": ["path", "digest", "media_type", "byte_length"],
			"properties": {
				"path": { "type": "string", "minLength": 1, "maxLength": 1024 },
				"digest": { "$ref": "primitives.schema.json#/$defs/Digest" },
				"media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" },
				"byte_length": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
			}
		},
		"CleanupReceipt": {
			"type": "object",
			"additionalProperties": false,
			"required": ["outcome", "handle"],
			"properties": {
				"outcome": { "type": "string", "enum": ["removed", "retained", "failed"] },
				"handle": { "type": "string", "minLength": 1, "maxLength": 256 }
			}
		},
		"FixtureLane": {
			"type": "object", "additionalProperties": false, "required": ["id", "predicate"],
			"properties": { "id": { "type": "integer", "minimum": 1, "maximum": 10 }, "predicate": { "type": "string", "minLength": 1 } }
		},
		"ProjectFixtureConfig": {
			"type": "object", "additionalProperties": false,
			"required": ["schema_version", "authority", "commands", "scenarios", "lanes", "driver", "timeout_ms", "target", "cleanup"],
			"properties": {
				"schema_version": { "type": "string", "enum": ["agora.verification-fixture/v1"] },
				"authority": { "type": "string", "enum": ["foundation_fixture"] },
				"commands": { "type": "array", "maxItems": 7, "items": {
					"type": "object", "additionalProperties": false, "required": ["command", "agora", "python"],
					"properties": {
						"command": { "$ref": "#/$defs/CliCommandName" },
						"agora": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
						"python": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1 } }
					}
				} },
				"scenarios": { "type": "array", "maxItems": 256, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
				"lanes": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/FixtureLane" } },
				"driver": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
				"units": { "type": "array", "maxItems": 16, "items": {
					"description": "Per-unit lane and perf manifest. A unit without lanes_unavailable runs its own driver when it names one, else the top-level lanes and driver. A perf entry without probe is unavailable for the stated reason; limits are absolute budgets in milliseconds, optionally a multiple of another metric.",
					"type": "object", "additionalProperties": false, "required": ["id", "perf"],
					"properties": {
						"id": { "type": "string", "pattern": "^U[0-9]{2}[a-z]?$" },
						"lanes": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/FixtureLane" } },
						"lanes_unavailable": { "type": "string", "minLength": 20, "maxLength": 1024 },
						"driver": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1 } },
						"perf": {
							"type": "object", "additionalProperties": false, "required": ["metric", "rule"],
							"properties": {
								"metric": { "type": "string", "minLength": 1 }, "rule": { "type": "string", "minLength": 1 },
								"probe": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1 } },
								"unavailable": { "type": "string", "minLength": 20, "maxLength": 1024 },
								"compare": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" } },
								"limits": { "type": "array", "maxItems": 16, "items": {
									"type": "object", "additionalProperties": false, "required": ["metric"],
									"properties": { "metric": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" }, "max": { "type": "integer", "minimum": 1, "maximum": 3600000 }, "ratio": { "type": "integer", "minimum": 1, "maximum": 1000 }, "of": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" } }
								} }
							}
						}
					}
				} },
				"timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
				"target": { "type": "string", "enum": ["local-foundation-fixture"] },
				"cleanup": { "type": "string", "minLength": 1 }
			}
		},
		"FixtureEffect": {
			"type": "object", "additionalProperties": false, "required": ["report", "object"],
			"properties": { "report": { "$ref": "fixture-policy.schema.json#/$defs/FixturePolicyDecisionReport" }, "object": { "$ref": "fixture-policy.schema.json#/$defs/FixturePolicyDecisionReport" } }
		},
		"FixtureEffects": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/FixtureEffect" } },
		"CliInstance": {
			"type": "object", "additionalProperties": false,
			"required": ["root", "pid", "process_start", "url", "database", "object_namespace", "cleanup_handle"],
			"properties": {
				"root": { "type": "string", "minLength": 1 },
				"pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
				"process_start": { "type": "string", "minLength": 1 },
				"url": { "type": "string", "pattern": "^http://127[.]0[.]0[.]1:[0-9]+$" },
				"database": { "type": "string", "minLength": 1 },
				"object_namespace": { "type": "string", "minLength": 1 },
				"cleanup_handle": { "$ref": "primitives.schema.json#/$defs/Uuid" }
			}
		},
		"CliReport": {
			"description": "JSON report of every R12 command: versions, outcome, diagnostics, artifacts, timestamps and the cleanup receipt. run_id is the instance identity for start, verify, evidence and stop.",
			"type": "object",
			"additionalProperties": false,
			"required": ["schema_version", "command", "versions", "outcome", "diagnostics", "artifacts", "started_at", "finished_at"],
			"properties": {
				"schema_version": { "type": "string", "enum": ["agora.cli-report/v1"] },
				"command": { "$ref": "#/$defs/CliCommandName" },
				"run_id": { "$ref": "primitives.schema.json#/$defs/Uuid" },
				"instance": { "$ref": "#/$defs/CliInstance" },
				"scenarios": { "type": "array", "maxItems": 256, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
				"scenario_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
				"versions": {
					"type": "object",
					"additionalProperties": false,
					"required": ["code", "config", "fixture"],
					"properties": {
						"code": { "$ref": "primitives.schema.json#/$defs/GitSha" },
						"config": { "$ref": "primitives.schema.json#/$defs/Digest" },
						"fixture": { "$ref": "primitives.schema.json#/$defs/Digest" }
					}
				},
				"outcome": { "$ref": "#/$defs/CliOutcome" },
				"diagnostics": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/Diagnostic" } },
				"artifacts": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/ArtifactReference" } },
				"started_at": { "$ref": "primitives.schema.json#/$defs/Timestamp" },
				"finished_at": { "$ref": "primitives.schema.json#/$defs/Timestamp" },
				"cleanup": { "$ref": "#/$defs/CleanupReceipt" }
			}
		}
	}
}

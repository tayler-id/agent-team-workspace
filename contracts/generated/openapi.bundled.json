{
	"openapi": "3.1.1",
	"jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
	"info": {
		"title": "Agora center foundation surface",
		"version": "1.0.0",
		"description": "Authoritative HTTP operations of the foundation fixture. components.schemas is populated from contracts/schemas/*.schema.json by scripts/generate-contracts.mjs; this file authors only operations."
	},
	"servers": [
		{
			"url": "http://127.0.0.1:3000"
		}
	],
	"paths": {
		"/api/v1/health": {
			"get": {
				"operationId": "getHealth",
				"summary": "Liveness; never touches a dependency",
				"responses": {
					"200": {
						"description": "Alive",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HealthReport"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/health/ready": {
			"get": {
				"operationId": "getReadiness",
				"summary": "Readiness; 200 when the database answers, else 503",
				"responses": {
					"200": {
						"description": "Ready",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReadinessReport"
								}
							}
						}
					},
					"503": {
						"description": "Not ready",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReadinessReport"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/fixture/policy/decisions": {
			"post": {
				"operationId": "decideFixturePolicy",
				"summary": "Pure scope decision of the non-production policy fixture",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/FixturePolicyCommand"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Decision",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/FixturePolicyDecisionReport"
								}
							}
						}
					},
					"400": {
						"description": "Malformed command; details name the offending paths",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorReport"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"ArtifactReference": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"path",
					"digest",
					"media_type",
					"byte_length"
				],
				"properties": {
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 1024
					},
					"digest": {
						"$ref": "#/components/schemas/Digest"
					},
					"media_type": {
						"type": "string",
						"pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
					},
					"byte_length": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					}
				}
			},
			"CleanupReceipt": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"outcome",
					"handle"
				],
				"properties": {
					"outcome": {
						"type": "string",
						"enum": [
							"removed",
							"retained",
							"failed"
						]
					},
					"handle": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					}
				}
			},
			"CliCommand": {
				"description": "Structured form of one registered project command (R12). The runner builds argv from this object; it never evaluates command text received from chat.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"command"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.cli-command/v1"
						]
					},
					"command": {
						"$ref": "#/components/schemas/CliCommandName"
					},
					"profile": {
						"type": "string",
						"enum": [
							"verify"
						]
					},
					"instance": {
						"$ref": "#/components/schemas/Uuid"
					},
					"scenario": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
					},
					"unit": {
						"type": "string",
						"pattern": "^U[0-9]{2}[a-d]?$"
					},
					"artifacts": {
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					}
				}
			},
			"CliCommandName": {
				"type": "string",
				"enum": [
					"doctor",
					"scenarios",
					"start",
					"verify",
					"evidence",
					"stop",
					"lanes"
				]
			},
			"CliOutcome": {
				"description": "Closed outcome set. Process exit follows the outcome exactly: pass 0, fail 1, blocked 2, unavailable 3, usage_error 64, infrastructure_failure 70. A report whose exit disagrees with its outcome is invalid evidence.",
				"type": "string",
				"enum": [
					"pass",
					"fail",
					"blocked",
					"unavailable",
					"usage_error",
					"infrastructure_failure"
				]
			},
			"CliReport": {
				"description": "JSON report of every R12 command: versions, outcome, diagnostics, artifacts, timestamps and the cleanup receipt. run_id is the instance identity for start, verify, evidence and stop.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"command",
					"versions",
					"outcome",
					"diagnostics",
					"artifacts",
					"started_at",
					"finished_at"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.cli-report/v1"
						]
					},
					"command": {
						"$ref": "#/components/schemas/CliCommandName"
					},
					"run_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"scenario_id": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
					},
					"versions": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"code",
							"config",
							"fixture"
						],
						"properties": {
							"code": {
								"$ref": "#/components/schemas/GitSha"
							},
							"config": {
								"$ref": "#/components/schemas/Digest"
							},
							"fixture": {
								"$ref": "#/components/schemas/Digest"
							}
						}
					},
					"outcome": {
						"$ref": "#/components/schemas/CliOutcome"
					},
					"diagnostics": {
						"type": "array",
						"maxItems": 256,
						"items": {
							"$ref": "#/components/schemas/Diagnostic"
						}
					},
					"artifacts": {
						"type": "array",
						"maxItems": 1024,
						"items": {
							"$ref": "#/components/schemas/ArtifactReference"
						}
					},
					"started_at": {
						"$ref": "#/components/schemas/Timestamp"
					},
					"finished_at": {
						"$ref": "#/components/schemas/Timestamp"
					},
					"cleanup": {
						"$ref": "#/components/schemas/CleanupReceipt"
					}
				}
			},
			"Diagnostic": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"reason_code",
					"message"
				],
				"properties": {
					"reason_code": {
						"$ref": "#/components/schemas/ReasonCode"
					},
					"message": {
						"type": "string",
						"maxLength": 4096
					}
				}
			},
			"Digest": {
				"description": "Algorithm-tagged SHA-256 over canonical bytes, lowercase hexadecimal.",
				"type": "string",
				"pattern": "^sha256:[0-9a-f]{64}$"
			},
			"ErrorReport": {
				"description": "Error body. Carries a reason code and a correlation id, never a secret value. details lists validator paths and messages for malformed_command.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"reason_code",
					"correlation_id"
				],
				"properties": {
					"reason_code": {
						"$ref": "#/components/schemas/ReasonCode"
					},
					"correlation_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"details": {
						"type": "array",
						"maxItems": 64,
						"items": {
							"type": "string",
							"maxLength": 1024
						}
					}
				}
			},
			"ExitCode": {
				"description": "The only process exit codes a verification command may return; see CliOutcome for their meaning.",
				"type": "integer",
				"enum": [
					0,
					1,
					2,
					3,
					64,
					70
				]
			},
			"FixturePolicyCommand": {
				"description": "Body of POST /api/v1/fixture/policy/decisions.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"actor",
					"subject"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.fixture-policy-command/v1"
						]
					},
					"actor": {
						"$ref": "#/components/schemas/ScopeReference"
					},
					"subject": {
						"$ref": "#/components/schemas/ScopeReference"
					}
				}
			},
			"FixturePolicyDecisionReport": {
				"description": "200 answer of POST /api/v1/fixture/policy/decisions. reason_code is present only for deny and is never null.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"decision",
					"policy_version",
					"policy_digest"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.fixture-policy-decision/v1"
						]
					},
					"decision": {
						"type": "string",
						"enum": [
							"allow",
							"deny"
						]
					},
					"reason_code": {
						"type": "string",
						"enum": [
							"scope_mismatch"
						]
					},
					"policy_version": {
						"type": "string",
						"enum": [
							"agora.fixture-policy/v1"
						]
					},
					"policy_digest": {
						"$ref": "#/components/schemas/Digest"
					}
				}
			},
			"GitSha": {
				"description": "Exact 40-hexadecimal Git object name.",
				"type": "string",
				"pattern": "^[0-9a-f]{40}$"
			},
			"HealthReport": {
				"description": "Answer of GET /api/v1/health. Touches no dependency.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"status",
					"service"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.health/v1"
						]
					},
					"status": {
						"type": "string",
						"enum": [
							"ok"
						]
					},
					"service": {
						"type": "string",
						"enum": [
							"agora-center"
						]
					}
				}
			},
			"ReadinessReport": {
				"description": "Answer of GET /api/v1/health/ready. 200 when ready, 503 when not_ready.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"status",
					"checks"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.readiness/v1"
						]
					},
					"status": {
						"type": "string",
						"enum": [
							"ready",
							"not_ready"
						]
					},
					"checks": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"database"
						],
						"properties": {
							"database": {
								"type": "string",
								"enum": [
									"ok",
									"unavailable"
								]
							}
						}
					}
				}
			},
			"ReasonCode": {
				"description": "Closed set of stable reason codes in use on the foundation surface. A new code is a contract change.",
				"type": "string",
				"enum": [
					"malformed_command",
					"not_found",
					"scope_mismatch",
					"blocked_prerequisite",
					"unavailable_capability",
					"usage_error",
					"infrastructure_failure"
				]
			},
			"Revision": {
				"description": "Nonnegative 64-bit integer as a decimal string without sign, leading zeros or exponent; the pattern is the exact bound 18446744073709551615.",
				"type": "string",
				"pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
			},
			"ScopeReference": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"scope_id"
				],
				"properties": {
					"scope_id": {
						"$ref": "#/components/schemas/Uuid"
					}
				}
			},
			"Timestamp": {
				"description": "UTC RFC 3339 date-time with the literal Z designator and up to nine fractional digits; numeric offsets are rejected.",
				"type": "string",
				"pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]{1,9})?Z$"
			},
			"Uuid": {
				"description": "RFC 9562 UUID in hyphenated hexadecimal form; either letter case is accepted, never the urn prefix.",
				"type": "string",
				"pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
			}
		}
	}
}

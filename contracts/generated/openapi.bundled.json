{
	"openapi": "3.1.1",
	"jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
	"info": {
		"title": "Agora center foundation surface",
		"version": "1.0.0",
		"description": "Authoritative HTTP operations of the foundation fixture. components.schemas is populated from contracts/schemas/*.schema.json by scripts/generate-contracts.mjs; this file authors only operations."
	},
	"servers": [
		{
			"url": "http://127.0.0.1:3000"
		}
	],
	"paths": {
		"/api/v1/health": {
			"get": {
				"operationId": "getHealth",
				"summary": "Liveness; never touches a dependency",
				"responses": {
					"200": {
						"description": "Alive",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HealthReport"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/health/ready": {
			"get": {
				"operationId": "getReadiness",
				"summary": "Readiness; 200 when the database answers, else 503",
				"responses": {
					"200": {
						"description": "Ready",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReadinessReport"
								}
							}
						}
					},
					"503": {
						"description": "Not ready",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReadinessReport"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/fixture/policy/decisions": {
			"post": {
				"operationId": "decideFixturePolicy",
				"summary": "Pure scope decision of the non-production policy fixture",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/FixturePolicyCommand"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Decision",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/FixturePolicyDecisionReport"
								}
							}
						}
					},
					"400": {
						"description": "Malformed command; details name the offending paths",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorReport"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/local-room/messages": {
			"post": {
				"operationId": "sendLocalRoomMessage",
				"summary": "Send one immutable message to the fixed local-development room; committed in one PostgreSQL transaction with the room counter, event and receipt (local-room L2)",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SendRoomMessageCommand"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Committed; identity, receipt and message id",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RoomCommandReceipt"
								}
							}
						}
					},
					"400": {
						"description": "Malformed command; details name the offending paths",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorReport"
								}
							}
						}
					},
					"404": {
						"description": "scope_mismatch when the command names another project or room; not_found when a citation names no persisted message; unavailable_capability when no persistence adapter is composed",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorReport"
								}
							}
						}
					},
					"409": {
						"description": "command_conflict: the same command_id was already committed with a different request digest",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorReport"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/local-room/snapshot": {
			"get": {
				"operationId": "getLocalRoomSnapshot",
				"summary": "Ordered history and cursor of the fixed local-development room from one repeatable read; at most the latest 1000 messages",
				"responses": {
					"200": {
						"description": "Snapshot",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RoomSnapshot"
								}
							}
						}
					},
					"404": {
						"description": "unavailable_capability: no persistence adapter is composed",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorReport"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"ArtifactReference": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"path",
					"digest",
					"media_type",
					"byte_length"
				],
				"properties": {
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 1024
					},
					"digest": {
						"$ref": "#/components/schemas/Digest"
					},
					"media_type": {
						"type": "string",
						"pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
					},
					"byte_length": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					}
				}
			},
			"CleanupReceipt": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"outcome",
					"handle"
				],
				"properties": {
					"outcome": {
						"type": "string",
						"enum": [
							"removed",
							"retained",
							"failed"
						]
					},
					"handle": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					}
				}
			},
			"CliCommand": {
				"description": "Structured form of one registered project command (R12). The runner builds argv from this object; it never evaluates command text received from chat.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"command"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.cli-command/v1"
						]
					},
					"command": {
						"$ref": "#/components/schemas/CliCommandName"
					},
					"profile": {
						"type": "string",
						"enum": [
							"verify"
						]
					},
					"instance": {
						"$ref": "#/components/schemas/Uuid"
					},
					"scenario": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
					},
					"unit": {
						"type": "string",
						"pattern": "^U[0-9]{2}[a-d]?$"
					},
					"artifacts": {
						"type": "string",
						"minLength": 1,
						"maxLength": 4096
					}
				}
			},
			"CliCommandName": {
				"type": "string",
				"enum": [
					"doctor",
					"scenarios",
					"start",
					"verify",
					"evidence",
					"stop",
					"lanes"
				]
			},
			"CliOutcome": {
				"description": "Closed outcome set. Process exit follows the outcome exactly: pass 0, fail 1, blocked 2, unavailable 3, usage_error 64, infrastructure_failure 70. A report whose exit disagrees with its outcome is invalid evidence.",
				"type": "string",
				"enum": [
					"pass",
					"fail",
					"blocked",
					"unavailable",
					"usage_error",
					"infrastructure_failure"
				]
			},
			"CliReport": {
				"description": "JSON report of every R12 command: versions, outcome, diagnostics, artifacts, timestamps and the cleanup receipt. run_id is the instance identity for start, verify, evidence and stop.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"command",
					"versions",
					"outcome",
					"diagnostics",
					"artifacts",
					"started_at",
					"finished_at"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.cli-report/v1"
						]
					},
					"command": {
						"$ref": "#/components/schemas/CliCommandName"
					},
					"run_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"scenario_id": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
					},
					"versions": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"code",
							"config",
							"fixture"
						],
						"properties": {
							"code": {
								"$ref": "#/components/schemas/GitSha"
							},
							"config": {
								"$ref": "#/components/schemas/Digest"
							},
							"fixture": {
								"$ref": "#/components/schemas/Digest"
							}
						}
					},
					"outcome": {
						"$ref": "#/components/schemas/CliOutcome"
					},
					"diagnostics": {
						"type": "array",
						"maxItems": 256,
						"items": {
							"$ref": "#/components/schemas/Diagnostic"
						}
					},
					"artifacts": {
						"type": "array",
						"maxItems": 1024,
						"items": {
							"$ref": "#/components/schemas/ArtifactReference"
						}
					},
					"started_at": {
						"$ref": "#/components/schemas/Timestamp"
					},
					"finished_at": {
						"$ref": "#/components/schemas/Timestamp"
					},
					"cleanup": {
						"$ref": "#/components/schemas/CleanupReceipt"
					}
				}
			},
			"CommandIdentity": {
				"description": "Idempotency identity of one command as R07 defines it: the same (actor, command_id) with the same request_digest replays the original receipt; a different digest is a conflict. The actor is not on the wire because the service derives it.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"command_id",
					"request_digest"
				],
				"properties": {
					"command_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"request_digest": {
						"$ref": "#/components/schemas/Digest"
					}
				}
			},
			"CommandReceipt": {
				"description": "R07 committed mutation receipt. It confirms a command, not that its events have been applied by a client. Duplicate actor/command/request digests return the original receipt.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"command_id",
					"aggregate_id",
					"revision",
					"event_cursors",
					"receipt_id"
				],
				"properties": {
					"command_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"aggregate_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"revision": {
						"$ref": "#/components/schemas/Revision"
					},
					"event_cursors": {
						"type": "array",
						"maxItems": 64,
						"items": {
							"$ref": "#/components/schemas/StreamCursor"
						}
					},
					"receipt_id": {
						"$ref": "#/components/schemas/Uuid"
					}
				}
			},
			"Diagnostic": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"reason_code",
					"message"
				],
				"properties": {
					"reason_code": {
						"$ref": "#/components/schemas/ReasonCode"
					},
					"message": {
						"type": "string",
						"maxLength": 4096
					}
				}
			},
			"Digest": {
				"description": "Algorithm-tagged SHA-256 over canonical bytes, lowercase hexadecimal.",
				"type": "string",
				"pattern": "^sha256:[0-9a-f]{64}$"
			},
			"ErrorReport": {
				"description": "Error body. Carries a reason code and a correlation id, never a secret value. details lists validator paths and messages for malformed_command.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"reason_code",
					"correlation_id"
				],
				"properties": {
					"reason_code": {
						"$ref": "#/components/schemas/ReasonCode"
					},
					"correlation_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"details": {
						"type": "array",
						"maxItems": 64,
						"items": {
							"type": "string",
							"maxLength": 1024
						}
					}
				}
			},
			"ExitCode": {
				"description": "The only process exit codes a verification command may return; see CliOutcome for their meaning.",
				"type": "integer",
				"enum": [
					0,
					1,
					2,
					3,
					64,
					70
				]
			},
			"FixturePolicyCommand": {
				"description": "Body of POST /api/v1/fixture/policy/decisions.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"actor",
					"subject"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.fixture-policy-command/v1"
						]
					},
					"actor": {
						"$ref": "#/components/schemas/ScopeReference"
					},
					"subject": {
						"$ref": "#/components/schemas/ScopeReference"
					}
				}
			},
			"FixturePolicyDecisionReport": {
				"description": "200 answer of POST /api/v1/fixture/policy/decisions. reason_code is present only for deny and is never null.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"decision",
					"policy_version",
					"policy_digest"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.fixture-policy-decision/v1"
						]
					},
					"decision": {
						"type": "string",
						"enum": [
							"allow",
							"deny"
						]
					},
					"reason_code": {
						"type": "string",
						"enum": [
							"scope_mismatch"
						]
					},
					"policy_version": {
						"type": "string",
						"enum": [
							"agora.fixture-policy/v1"
						]
					},
					"policy_digest": {
						"$ref": "#/components/schemas/Digest"
					}
				}
			},
			"FixtureSyncMessage": {
				"description": "Visible fixture message position. created_seq is the first visible revision's room-stream sequence and never changes on an edit. The fixture body is limited to 4096 Unicode scalars, at most 16 KiB UTF-8; this is not a production composer contract.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"message_id",
					"created_seq",
					"revision",
					"body"
				],
				"properties": {
					"message_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"created_seq": {
						"$ref": "#/components/schemas/Revision"
					},
					"revision": {
						"$ref": "#/components/schemas/Revision"
					},
					"body": {
						"type": "string",
						"maxLength": 4096
					}
				}
			},
			"FixtureSyncMessageEvent": {
				"description": "R07 envelope with one closed, non-production fixture message-revision payload. actor is a historical principal ID, not caller authority.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"stream_id",
					"seq",
					"event_id",
					"kind",
					"actor",
					"occurred_at",
					"payload"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.foundation-fixture.sync-event/v1"
						]
					},
					"stream_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"seq": {
						"$ref": "#/components/schemas/Revision"
					},
					"event_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"kind": {
						"type": "string",
						"enum": [
							"fixture.message_revision"
						]
					},
					"actor": {
						"$ref": "#/components/schemas/Uuid"
					},
					"occurred_at": {
						"$ref": "#/components/schemas/Timestamp"
					},
					"payload": {
						"$ref": "#/components/schemas/FixtureSyncMessage"
					}
				}
			},
			"FixtureSyncRunCard": {
				"description": "Display-only revisioned fixture card, not a run state machine. An older run_revision cannot overwrite a newer card.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"run_id",
					"run_revision",
					"state"
				],
				"properties": {
					"run_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"run_revision": {
						"$ref": "#/components/schemas/Revision"
					},
					"state": {
						"type": "string",
						"enum": [
							"queued",
							"running",
							"succeeded",
							"failed"
						]
					}
				}
			},
			"FixtureSyncRunCardEvent": {
				"description": "Closed fixture card event. Event seq orders delivery; run_revision orders projection replacement.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"stream_id",
					"seq",
					"event_id",
					"kind",
					"actor",
					"occurred_at",
					"payload"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.foundation-fixture.sync-event/v1"
						]
					},
					"stream_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"seq": {
						"$ref": "#/components/schemas/Revision"
					},
					"event_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"kind": {
						"type": "string",
						"enum": [
							"fixture.run_card"
						]
					},
					"actor": {
						"$ref": "#/components/schemas/Uuid"
					},
					"occurred_at": {
						"$ref": "#/components/schemas/Timestamp"
					},
					"payload": {
						"$ref": "#/components/schemas/FixtureSyncRunCard"
					}
				}
			},
			"FixtureSyncSnapshot": {
				"description": "Authorized non-production fixture state and cursor from one observation. last_seen_room_seq is explicit reading state, not advanced by event delivery. Unread counts only visible message positions created after it, not stream-sequence distance.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"cursor",
					"last_seen_room_seq",
					"state"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.foundation-fixture.sync-snapshot/v1"
						]
					},
					"cursor": {
						"$ref": "#/components/schemas/StreamCursor"
					},
					"last_seen_room_seq": {
						"$ref": "#/components/schemas/Revision"
					},
					"state": {
						"$ref": "#/components/schemas/FixtureSyncState"
					}
				}
			},
			"FixtureSyncState": {
				"description": "Complete fixture projection at its snapshot cursor. A message ID occurs in messages or tombstones, never both; adapters enforce cross-record consistency after schema validation.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"messages",
					"tombstones",
					"run_cards"
				],
				"properties": {
					"messages": {
						"type": "array",
						"maxItems": 50000,
						"items": {
							"$ref": "#/components/schemas/FixtureSyncMessage"
						}
					},
					"tombstones": {
						"type": "array",
						"maxItems": 50000,
						"items": {
							"$ref": "#/components/schemas/FixtureSyncTombstone"
						}
					},
					"run_cards": {
						"type": "array",
						"maxItems": 1000,
						"items": {
							"$ref": "#/components/schemas/FixtureSyncRunCard"
						}
					}
				}
			},
			"FixtureSyncTombstone": {
				"description": "A deleted fixture position carries no body and creates no unread position.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"message_id",
					"created_seq",
					"revision"
				],
				"properties": {
					"message_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"created_seq": {
						"$ref": "#/components/schemas/Revision"
					},
					"revision": {
						"$ref": "#/components/schemas/Revision"
					}
				}
			},
			"FixtureSyncTombstoneEvent": {
				"description": "Closed fixture tombstone event; deleted content is not carried on the wire.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"stream_id",
					"seq",
					"event_id",
					"kind",
					"actor",
					"occurred_at",
					"payload"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.foundation-fixture.sync-event/v1"
						]
					},
					"stream_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"seq": {
						"$ref": "#/components/schemas/Revision"
					},
					"event_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"kind": {
						"type": "string",
						"enum": [
							"fixture.message_tombstone"
						]
					},
					"actor": {
						"$ref": "#/components/schemas/Uuid"
					},
					"occurred_at": {
						"$ref": "#/components/schemas/Timestamp"
					},
					"payload": {
						"$ref": "#/components/schemas/FixtureSyncTombstone"
					}
				}
			},
			"FoundationProof": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"id",
					"subject",
					"revision",
					"outcome",
					"denials"
				],
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9_-]{1,64}$"
					},
					"subject": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					},
					"revision": {
						"$ref": "#/components/schemas/GitSha"
					},
					"outcome": {
						"type": "string",
						"enum": [
							"pass",
							"fail",
							"blocked",
							"unavailable"
						]
					},
					"denials": {
						"type": "array",
						"maxItems": 64,
						"items": {
							"type": "string",
							"maxLength": 128
						}
					}
				}
			},
			"FoundationReport": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"authority",
					"task",
					"scope",
					"outcome",
					"task_outcome",
					"unit_outcome",
					"foundation_outcome",
					"proofs",
					"denials",
					"artifacts"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.foundation/v1"
						]
					},
					"authority": {
						"type": "string",
						"enum": [
							"foundation_fixture"
						]
					},
					"task": {
						"type": "string",
						"enum": [
							"agora-s1-enforce-test-first"
						]
					},
					"scope": {
						"type": "string",
						"enum": [
							"record",
							"task",
							"foundation",
							"feature",
							"lane-9",
							"lane-10",
							"invalid"
						]
					},
					"parent": {
						"$ref": "#/components/schemas/GitSha"
					},
					"head": {
						"$ref": "#/components/schemas/GitSha"
					},
					"outcome": {
						"$ref": "#/components/schemas/CliOutcome"
					},
					"task_outcome": {
						"type": "string",
						"enum": [
							"pass",
							"fail",
							"blocked"
						]
					},
					"unit_outcome": {
						"type": "string",
						"enum": [
							"blocked"
						]
					},
					"foundation_outcome": {
						"type": "string",
						"enum": [
							"blocked"
						]
					},
					"proofs": {
						"type": "array",
						"maxItems": 64,
						"items": {
							"$ref": "#/components/schemas/FoundationProof"
						}
					},
					"denials": {
						"type": "array",
						"maxItems": 128,
						"items": {
							"type": "string",
							"maxLength": 128
						}
					},
					"artifacts": {
						"type": "array",
						"maxItems": 128,
						"items": {
							"$ref": "#/components/schemas/ArtifactReference"
						}
					}
				}
			},
			"GitSha": {
				"description": "Exact 40-hexadecimal Git object name.",
				"type": "string",
				"pattern": "^[0-9a-f]{40}$"
			},
			"HealthReport": {
				"description": "Answer of GET /api/v1/health. Touches no dependency.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"status",
					"service"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.health/v1"
						]
					},
					"status": {
						"type": "string",
						"enum": [
							"ok"
						]
					},
					"service": {
						"type": "string",
						"enum": [
							"agora-center"
						]
					}
				}
			},
			"LocalRoomScope": {
				"description": "Project and room identity of one local room. Both are opaque UUIDs fixed by the local development service (L2), never chosen from a hosted workspace.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"project_id",
					"room_id"
				],
				"properties": {
					"project_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"room_id": {
						"$ref": "#/components/schemas/Uuid"
					}
				}
			},
			"ReadinessReport": {
				"description": "Answer of GET /api/v1/health/ready. 200 when ready, 503 when not_ready.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"status",
					"checks"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.readiness/v1"
						]
					},
					"status": {
						"type": "string",
						"enum": [
							"ready",
							"not_ready"
						]
					},
					"checks": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"database"
						],
						"properties": {
							"database": {
								"type": "string",
								"enum": [
									"ok",
									"unavailable"
								]
							}
						}
					}
				}
			},
			"ReasonCode": {
				"description": "Closed set of stable reason codes in use on the foundation surface. A new code is a contract change. command_conflict is the R07 409: the same actor and command_id reused with a different request digest.",
				"type": "string",
				"enum": [
					"malformed_command",
					"not_found",
					"scope_mismatch",
					"command_conflict",
					"blocked_prerequisite",
					"unavailable_capability",
					"usage_error",
					"infrastructure_failure"
				]
			},
			"RecordCitation": {
				"description": "Reference to a record already persisted in the same room. record_kind is closed; L1 knows only messages. room_seq repeats the cited message's sequence so a reader can locate it without a lookup; adapters check that the record exists at or below the citing message.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"record_kind",
					"record_id",
					"room_seq"
				],
				"properties": {
					"record_kind": {
						"type": "string",
						"enum": [
							"message"
						]
					},
					"record_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"room_seq": {
						"$ref": "#/components/schemas/Revision"
					}
				}
			},
			"Revision": {
				"description": "Nonnegative 64-bit integer as a decimal string without sign, leading zeros or exponent; the pattern is the exact bound 18446744073709551615.",
				"type": "string",
				"pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
			},
			"RoomAuthor": {
				"description": "Who wrote a persisted message. The service derives it from the caller; a command never carries it. local_agent is the bounded local center response (L5), labelled explicitly and never a live model provider.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"kind",
					"principal_id"
				],
				"properties": {
					"kind": {
						"type": "string",
						"enum": [
							"human",
							"local_agent"
						]
					},
					"principal_id": {
						"$ref": "#/components/schemas/Uuid"
					}
				}
			},
			"RoomCommandReceipt": {
				"description": "201 answer of a committed send. receipt is the reusable R07 receipt (aggregate_id is the room, revision its room_seq after the append). replayed is true when identity matched an earlier command and the original receipt was returned without a second message.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"identity",
					"receipt",
					"message_id",
					"replayed"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.local-room.receipt/v1"
						]
					},
					"identity": {
						"$ref": "#/components/schemas/CommandIdentity"
					},
					"receipt": {
						"$ref": "#/components/schemas/CommandReceipt"
					},
					"message_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"replayed": {
						"type": "boolean"
					}
				}
			},
			"RoomMessage": {
				"description": "One immutable persisted message. room_seq is the room stream's per-room counter allocated in the same transaction as the message; a snapshot lists messages in ascending room_seq. L1 defines no edit or tombstone: a correction is a new message. command_id names the command that created it.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"message_id",
					"scope",
					"room_seq",
					"author",
					"command_id",
					"body",
					"citations",
					"created_at"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.local-room.message/v1"
						]
					},
					"message_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"scope": {
						"$ref": "#/components/schemas/LocalRoomScope"
					},
					"room_seq": {
						"$ref": "#/components/schemas/Revision"
					},
					"author": {
						"$ref": "#/components/schemas/RoomAuthor"
					},
					"command_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"body": {
						"$ref": "#/components/schemas/RoomMessageBody"
					},
					"citations": {
						"type": "array",
						"maxItems": 10,
						"items": {
							"$ref": "#/components/schemas/RecordCitation"
						}
					},
					"created_at": {
						"$ref": "#/components/schemas/Timestamp"
					}
				}
			},
			"RoomMessageBody": {
				"description": "Message text: 1 to 4096 Unicode scalars (at most 16 KiB UTF-8). Rendered as text, never as markup.",
				"type": "string",
				"minLength": 1,
				"maxLength": 4096
			},
			"RoomMessageCreatedEvent": {
				"description": "R07 envelope for the one L1 event kind. stream_id is the room_id and seq equals the payload's room_seq. actor is the historical principal, not caller authority. An unknown kind is refused on the wire, so a client never acknowledges an event it cannot apply.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"stream_id",
					"seq",
					"event_id",
					"kind",
					"actor",
					"occurred_at",
					"payload"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.local-room.event/v1"
						]
					},
					"stream_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"seq": {
						"$ref": "#/components/schemas/Revision"
					},
					"event_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"kind": {
						"type": "string",
						"enum": [
							"local_room.message_created"
						]
					},
					"actor": {
						"$ref": "#/components/schemas/Uuid"
					},
					"occurred_at": {
						"$ref": "#/components/schemas/Timestamp"
					},
					"payload": {
						"$ref": "#/components/schemas/RoomMessage"
					}
				}
			},
			"RoomSnapshot": {
				"description": "Room state and cursor from one repeatable read. Subscription starts strictly after cursor.committed_seq; messages are ascending by room_seq and bounded so a reader never receives an unbounded history in one answer.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"scope",
					"cursor",
					"messages"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.local-room.snapshot/v1"
						]
					},
					"scope": {
						"$ref": "#/components/schemas/LocalRoomScope"
					},
					"cursor": {
						"$ref": "#/components/schemas/StreamCursor"
					},
					"messages": {
						"type": "array",
						"maxItems": 1000,
						"items": {
							"$ref": "#/components/schemas/RoomMessage"
						}
					}
				}
			},
			"ScopeReference": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"scope_id"
				],
				"properties": {
					"scope_id": {
						"$ref": "#/components/schemas/Uuid"
					}
				}
			},
			"SendRoomMessageCommand": {
				"description": "Body of POST /api/v1/local-room/messages. command_id is the client's idempotency key; the service derives the actor and computes request_digest over these canonical bytes (see CommandIdentity). citations is required so absent and empty never differ in the digest.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"schema_version",
					"command_id",
					"scope",
					"body",
					"citations"
				],
				"properties": {
					"schema_version": {
						"type": "string",
						"enum": [
							"agora.local-room.send-message/v1"
						]
					},
					"command_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"scope": {
						"$ref": "#/components/schemas/LocalRoomScope"
					},
					"body": {
						"$ref": "#/components/schemas/RoomMessageBody"
					},
					"citations": {
						"type": "array",
						"maxItems": 10,
						"items": {
							"$ref": "#/components/schemas/RecordCitation"
						}
					}
				}
			},
			"StreamCursor": {
				"description": "Last committed and applied sequence for one stream. Streams have no global order.",
				"type": "object",
				"additionalProperties": false,
				"required": [
					"stream_id",
					"committed_seq"
				],
				"properties": {
					"stream_id": {
						"$ref": "#/components/schemas/Uuid"
					},
					"committed_seq": {
						"$ref": "#/components/schemas/Revision"
					}
				}
			},
			"Timestamp": {
				"description": "UTC RFC 3339 date-time with the literal Z designator and up to nine fractional digits; numeric offsets are rejected.",
				"type": "string",
				"pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]{1,9})?Z$"
			},
			"Uuid": {
				"description": "RFC 9562 UUID in hyphenated hexadecimal form; either letter case is accepted, never the urn prefix.",
				"type": "string",
				"pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
			}
		}
	}
}

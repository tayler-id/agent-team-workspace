 	expect(synchronize(drive(snapshot(), submit, { type: 'receipt', receipt }), { type: 'retry', commandId: 'c', requestDigest: 'hash', online: true, failure: { tag: 'timeout' } }).requests).toEqual([{ type: 'receipt_known', commandId: 'c' }]);

+test('short socket denial, collision and idempotent cleanup', () => {
+	const lease = allocatePostgresSocket(artifacts);
+	writeFileSync(`${artifacts}/evidence`, 'retained');
+	try {
+		expect(lease.identity.socketDir.startsWith(`${realpathSync('/tmp')}/agora-p0c-`), 'deny long artifact socket location').toBe(true);
+		expect(Buffer.byteLength(`${lease.identity.socketDir}/.s.PGSQL.5432`)).toBeLessThan(104);
+		expect(readFileSync(`${lease.identity.socketDir}/owner.json`, 'utf8')).toBe(JSON.stringify(lease.identity));
+		expect(() => allocatePostgresSocket(artifacts, lease.identity.runId)).toThrow('EEXIST');
+		const other = allocatePostgresSocket(artifacts);
+		try { expect(other.identity.socketDir).not.toBe(lease.identity.socketDir); } finally { other.cleanup(); }
+		lease.cleanup();
+		lease.cleanup();
+		expect(existsSync(lease.identity.socketDir)).toBe(false);
+		expect(readFileSync(`${artifacts}/evidence`, 'utf8')).toBe('retained');
+	} finally { lease.cleanup(); }
+});

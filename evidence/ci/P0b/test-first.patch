diff --git a/scripts/test/ci-doctor.test.ts b/scripts/test/ci-doctor.test.ts
index d1a76b5..b356717 100644
--- a/scripts/test/ci-doctor.test.ts
+++ b/scripts/test/ci-doctor.test.ts
@@ -1,9 +1,59 @@
 import assert from 'node:assert/strict';
 import { spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { copyFileSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';
+import path from 'node:path';
 import { test } from 'node:test';
 
+const root = path.resolve(import.meta.dirname, '../..');
+const run = (file: string, args: string[] = [], env = process.env) => spawnSync(process.execPath, [file, ...args], { encoding: 'utf8', env, timeout: 30_000 });
+const digest = (text: string) => createHash('sha256').update(text).digest('hex');
 await test('doctor public help baseline', () => {
-	const result = spawnSync(process.execPath, ['scripts/ci-doctor.mjs', '--help'], { encoding: 'utf8' });
+	const result = run('scripts/ci-doctor.mjs', ['--help']);
 	assert.equal(result.status, 0);
 	assert.match(result.stdout, /read-only Node\/pnpm\/Rolldown prerequisites/);
 });
+await test('G01 real locked native import and exact toolchain are ready', () => {
+	const result = run('scripts/ci-doctor.mjs', ['--json']);
+	assert.equal(result.status, 0, result.stdout + result.stderr);
+	assert.match(result.stdout, /"outcome":"pass"/);
+	for (const id of ['node', 'pnpm', 'rolldown']) assert.match(result.stdout, new RegExp(`"id":"${id}","outcome":"pass"`));
+	assert.match(run('scripts/ci-doctor.mjs').stdout, /rolldown: pass/);
+	assert.equal(run('scripts/ci-doctor.mjs', ['--unknown']).status, 64);
+});
+for (const id of ['node', 'pnpm', 'rolldown']) await test(`G01 ${id} denial and omitted-probe guard`, () => {
+	mkdirSync('.scratch', { recursive: true });
+	const dir = mkdtempSync(path.join(root, '.scratch/doctor-'));
+	const source = readFileSync('scripts/ci-doctor.mjs', 'utf8');
+	const file = path.join(dir, 'scripts/ci-doctor.mjs');
+	const env = { ...process.env };
+	try {
+		mkdirSync(path.dirname(file));
+		for (const name of ['.node-version', 'package.json']) copyFileSync(name, path.join(dir, name));
+		writeFileSync(file, source);
+		symlinkSync(path.join(root, 'node_modules'), path.join(dir, 'node_modules'), 'dir');
+		const fixture = id === 'node' ? '0.0.0\n' : id === 'pnpm' ? '#!/bin/sh\necho 0.0.0\n' : "process.dlopen = () => { throw new Error('fixture native binding unavailable'); };\n";
+		if (id === 'node') writeFileSync(path.join(dir, '.node-version'), fixture);
+		if (id === 'pnpm') {
+			writeFileSync(path.join(dir, 'pnpm'), fixture, { mode: 0o700 });
+			env.PATH = `${dir}:${env.PATH ?? ''}`;
+		}
+		if (id === 'rolldown') {
+			writeFileSync(path.join(dir, 'unavailable.cjs'), fixture);
+			env.NODE_OPTIONS = `--require=${path.join(dir, 'unavailable.cjs')}`;
+		}
+		const denied = run(file, ['--json'], env);
+		assert.equal(denied.status, 2, denied.stdout + denied.stderr);
+		assert.match(denied.stdout, new RegExp(`"id":"${id}","outcome":"blocked"`));
+		const marker = `await probe('${id}',`;
+		assert.equal(source.split(marker).length, 2, 'exactly one guarding call');
+		const weakened = source.replace(marker, `await (async () => {})('${id}',`);
+		writeFileSync(file, weakened);
+		const denial = run('--input-type=module', ['-e', `import assert from 'node:assert/strict'; import {spawnSync} from 'node:child_process'; const r=spawnSync(process.execPath,[process.argv[1],'--json']); assert.equal(r.status,2,'G01.${id}-denial');`, file], env);
+		assert.equal(denial.status, 1, denial.stderr);
+		assert.match(denial.stderr, new RegExp(`G01.${id}-denial`));
+		console.error(JSON.stringify({ guard: id, normal: digest(source), weakened: digest(weakened), fixture: digest(fixture), denied: denied.stdout.trim(), denial_exit: denial.status, assertion: denial.stderr }));
+	} finally {
+		rmSync(dir, { recursive: true, force: true });
+	}
+});
